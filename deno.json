{
  "name": "criba",
  "version": "0.0.1",
  "tasks": {
    "test": "deno test --allow-none src/",
    "check": "deno check src/",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "bundle": "deno bundle --platform browser web/main.ts -o web/dist/main.js"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  }
}
